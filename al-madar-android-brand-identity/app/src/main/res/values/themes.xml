<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlMadar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand_navy_dark</item>
        <item name="android:navigationBarColor">@color/brand_navy_dark</item>
        <item name="android:windowBackground">@color/brand_navy_dark</item>
    </style>

    <style name="Theme.AlMadar.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.AlMadar</item>
    </style>
</resources>
